{
  "name": "@pitwall/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main/worker.ts",
    "migrate": "tsx --env-file-if-exists=../../.env src/main/migrate.ts",
    "sync": "tsx --env-file-if-exists=../../.env src/main/sync.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.2",
    "@pitwall/contracts": "workspace:*",
    "@scalar/fastify-api-reference": "1.74.0",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "graphile-worker": "0.18.0",
    "ioredis": "6.0.0",
    "kysely": "0.29.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "ts-pattern": "5.9.1",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-v8": "5.0.4",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vitest": "5.0.4"
  }
}
