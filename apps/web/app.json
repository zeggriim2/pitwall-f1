{
  "expo": {
    "name": "Pitwall",
    "slug": "pitwall",
    "scheme": "pitwall",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.pitwall.app"
    },
    "android": {
      "package": "dev.pitwall.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router"]
  }
}
