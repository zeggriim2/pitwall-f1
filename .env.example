# Copied to .env by `task setup`. Values below match docker-compose.yml.
NODE_ENV=development
LOG_LEVEL=info
PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8080,http://localhost:8081
DATABASE_URL=postgres://pitwall:pitwall@localhost:5432/pitwall
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600
OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_MIN_INTERVAL_MS=2100
WORKER_CONCURRENCY=2
FUEL_EFFECT_SECONDS_PER_LAP=0.035
# Used by the Expo app in local dev (outside Docker the web app calls the API directly)
EXPO_PUBLIC_API_URL=http://localhost:3000
